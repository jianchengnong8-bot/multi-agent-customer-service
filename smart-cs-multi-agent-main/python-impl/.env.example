# LLM Provider (支持 OpenAI 兼容接口，如 DeepSeek)
# 使用 DeepSeek: 填入 DeepSeek Key，BASE_URL 指向 https://api.deepseek.com/v1
# 使用 OpenAI:  填入 OpenAI Key，BASE_URL 注释掉或指向 https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# Redis (短期记忆)
REDIS_URL=redis://localhost:6379/0

# Vector Store (长期记忆)
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./vector_store/faiss_index
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# OpenTelemetry (全链路追踪)
OTEL_SERVICE_NAME=smart-cs-multi-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=always_on

# LangSmith (可选)
# LANGSMITH_API_KEY=ls-your-langsmith-key
# LANGSMITH_PROJECT=smart-cs-agent

# Server
HOST=0.0.0.0
PORT=8000
